# =============================================================================
# inkai-app — Dual Mode: Lokal vs Online
# =============================================================================
# Salin ke .env.local (lokal) dan set variabel yang SAMA di Vercel (online)
# supaya perilaku lokal dan online konsisten saat ada perubahan.
# Jangan commit .env.local (sudah di .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# WAJIB — Supabase
# -----------------------------------------------------------------------------
# LOKAL (Supabase local: supabase start):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<dari output `supabase start`>
# SUPABASE_SERVICE_ROLE_KEY=<dari output `supabase start`>
#
# ONLINE (Supabase Cloud):
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key dari Dashboard > Settings > API>
# SUPABASE_SERVICE_ROLE_KEY=<service_role key dari Dashboard > Settings > API>

# -----------------------------------------------------------------------------
# OPSIONAL — Superadmin (env-based)
# -----------------------------------------------------------------------------
# INKAI_ROOT_EMAIL=...              # server-only (requireSuperadmin)
# NEXT_PUBLIC_INKAI_ROOT_EMAIL=...   # client + sidebar/settings (canAccess, Settings page)

# -----------------------------------------------------------------------------
# OPSIONAL — Reset password (email)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# INKAI_SMTP_HOST=smtp.example.com
# INKAI_SMTP_PORT=465
# INKAI_SMTP_USER=...
# INKAI_SMTP_PASS=...

# -----------------------------------------------------------------------------
# OPSIONAL — Verifikasi nomor via WhatsApp (Twilio)
# -----------------------------------------------------------------------------
# Tanpa ini, tombol "Kirim kode ke WhatsApp" di profil akan gagal (503).
# Panduan: docs/WHATSAPP-OTP.md
#
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# PHONE_OTP_PEPPER=<string acak ≥32 karakter; openssl rand -hex 32>

# -----------------------------------------------------------------------------
# OPSIONAL — Lainnya
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_INSTAGRAM_BASE_URL=...
