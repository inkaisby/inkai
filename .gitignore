# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Claude Code – personal project settings (keep shared .claude/settings.json)
.claude/settings.local.json

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase local dev runtime artifacts (generated by `supabase start`)
supabase/.branches/
supabase/.temp/start-secrets/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
